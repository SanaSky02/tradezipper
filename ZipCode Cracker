import csv
import sys
import os
import time
import shutil

def cols():
    return shutil.get_terminal_size().columns

def center(text, color=""):
    w = cols()
    for line in text.split("\n"):
        clean = line
        pad = max(0, (w - len(clean)) // 2)
        print(f"{color}{' ' * pad}{line}{RESET}")

def slow(text, color="". delay=0.0029):
    for ch in text: 
        sys.stdout.write(f"{color}{ch}{RESET}")
        sys.stdout.flush()
        time.sleep(delay)
    print()

def section_header(text):
    w = min(cols() - 4, 60)
    pad = max(0, (cols() -w) // 2)
    sp = " " * pad
    print(f"\n{sp}{CYAN}{'=' * w}{RESET}")
    center(text, f"{CYAN}{BOLD}")
    print(f"{sp}{CYAN}{'=' * w}{RESET}")

